APP_ENV=development
APP_PORT=8080
DATABASE_URL=postgres://user:password@localhost:5432/clearhire?sslmode=disable
# O servidor agora recusa subir com este valor literal, mesmo em dev — troque
# por um segredo real (ex: openssl rand -base64 48). Fora de development,
# também precisa ter pelo menos 32 caracteres.
JWT_SECRET=changeme
# Origem exata do frontend autenticado (subdomínio da ferramenta, não o domínio raiz da
# landing) — também reaproveitada para montar os links de e-mail de convite/redefinição
# de senha (ver internal/factory/factory.go). Aceita múltiplas origens separadas por vírgula.
# Produção: CORS_ORIGIN=https://app.clearhire.example
CORS_ORIGIN=http://localhost:4200

# --- IA (extração de currículo e análise de candidato) ---------------------------------------
# Quem faz o trabalho de IA: deterministic (padrão — regex + dicionário, custo zero, sem rede),
# groq ou anthropic. Variável em branco vale como "não definida".
# Qualquer valor diferente de deterministic EXIGE a chave do provedor: o servidor recusa subir sem
# ela em vez de degradar em silêncio. A análise por IA (match %, pontos fortes/atenção) só existe
# com groq; com os outros provedores a rota POST /candidates/:id/assessment responde 503.
LLM_PROVIDER=deterministic

# Groq — free tier serve para teste (30 req/min, ~8K tokens/min, ~200K tokens/dia por modelo; muita
# candidatura seguida recebe 429 e o candidato é orientado a usar o formulário manual).
# Chave em console.groq.com. Recomendado ligar "Zero Data Retention" no console: currículo é dado
# pessoal e a Groq processa nos EUA (transferência internacional — ver texto de consentimento).
# Só aceita modelos com saída estruturada estrita e preço conhecido em pkg/llm/pricing.go.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Endpoint alternativo compatível com a API da Groq (proxy interno). Normalmente vazio.
GROQ_BASE_URL=

# Anthropic (só extração; sem análise de candidato).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Quantas chamadas ao provedor de IA podem estar em voo ao mesmo tempo (protege o limite de taxa
# da chave e os workers HTTP). Erros sem resposta (429/5xx/rede) são re-tentados; respostas já
# cobradas nunca.
LLM_MAX_CONCURRENCY=4

# --- Rede -------------------------------------------------------------------------------------
# O rate limit por IP precisa do IP REAL do cliente. Atrás de nginx/plataforma, liste aqui os
# IPs/CIDRs do proxy (só deles se aceita CLIENT_IP_HEADER); sem isso todo cliente aparece com o IP
# do proxy e divide um único balde. Padrão: só loopback (dev). Docker compose: 172.16.0.0/12.
# CLIENT_IP_HEADER tem que ser um header que o proxy SOBRESCREVE com o IP da conexão (X-Real-IP no
# nginx do projeto; Fly-Client-IP no Fly.io) — nunca X-Forwarded-For, que acumula o que o cliente mandar.
TRUSTED_PROXIES=127.0.0.1,::1
CLIENT_IP_HEADER=X-Real-IP
